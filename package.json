{
  "name": "@skillre/dsh-plugin-skills-manager",
  "version": "0.2.0",
  "description": "DSH 技能管理：检索、安装、本地更新检查、更新与安全删除",
  "icon": "./icon.svg",
  "type": "module",
  "license": "MIT",
  "author": "skillre",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "packageManager": "npm@11.12.1",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./compatibility.json": "./compatibility.json",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "compatibility.json",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "UNINSTALL.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skillre/dsh-plugin-skills-manager.git"
  },
  "bugs": {
    "url": "https://github.com/skillre/dsh-plugin-skills-manager/issues"
  },
  "homepage": "https://github.com/skillre/dsh-plugin-skills-manager#readme",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cordis"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pack:check": "npm run build && publint && npm pack --dry-run --json --ignore-scripts",
    "check": "npm run typecheck && npm test && npm run pack:check && git diff --exit-code -- lib",
    "changeset": "changeset",
    "version": "changeset version",
    "release:prepare": "node scripts/prepare-release.mjs",
    "prepack": "npm run build",
    "test:integration": "node scripts/verify-isolated.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "esbuild": "0.28.2",
    "publint": "^0.3.24",
    "react": "18.3.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  }
}
